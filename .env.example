# Copy this file to .env (`cp .env.example .env`) and adjust values as needed.
# docker compose reads .env automatically for variable substitution.
# NOTE: never commit .env to version control.

# ---- PostgreSQL (provisioned by docker-compose) ----
POSTGRES_USER=unipods
POSTGRES_PASSWORD=unipods_dev_password
POSTGRES_DB=unipods

# ---- WAHA (WhatsApp HTTP API) ----
# API key for WAHA. Set to any long random string; every request to WAHA's API must
# send it as the `X-Api-Key` header. The backend uses this same value for /health.
WAHA_API_KEY=waha_dev_key_change_me
# Host port WAHA's Swagger/API is published on.
WAHA_PORT=3000

# ---- Backend ----
# Host port the backend API (GET /health, GET /messages) is published on.
BACKEND_PORT=8000

# ---- Internal URLs (as seen from INSIDE the docker network - leave as-is) ----
# Used by the backend to reach the WAHA API.
WAHA_BASE_URL=http://waha:3000
# Used by WAHA to deliver webhooks to the backend.
WHATSAPP_HOOK_URL=http://backend:8000/webhook/waha

# WAHA session name used when pairing the bot's WhatsApp account.
WAHA_SESSION=default

# ---- Optional overrides ----
# Backend -> Postgres connection string. Built automatically from POSTGRES_* above;
# set this only if you point the backend at a database outside compose.
# DATABASE_URL=postgresql+psycopg2://unipods:unipods_dev_password@postgres:5432/unipods
# Redis is pre-provisioned for the Phase 3 job queue (unused by Phase 1 code).
# REDIS_URL=redis://redis:6379/0

# ---- Phase 2/3: embeddings / sessionization / retrieval / answer ----
# Embedding provider: "openai_compatible" (an OpenAI-style /embeddings server),
# "gemini" (Google Gemini via google-genai), or "mock" (deterministic vectors,
# DEV ONLY - no API key needed, runs offline).
# The real provider must output EMBEDDING_DIMENSIONS-d vectors to match the
# chunks.embedding VECTOR(1024) column. Gemini truncates server-side via Gemini's
# MRL output_dimensionality. Default model gemini-embedding-001 (native 3072-d)
# truncated to 1024 fits the schema.
# Example with local Ollama: EMBEDDING_PROVIDER=openai_compatible
#                           EMBEDDING_API_URL=http://host.docker.internal:11434/v1
EMBEDDING_PROVIDER=mock
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64

# ---- Phase 3: Gemini ----
# Google AI Studio / Gemini API key. Required when EMBEDDING_PROVIDER=gemini or
# ANSWER_PROVIDER=gemini. Leave empty to run fully offline with mock/extractive.
# GEMINI_API_KEY=

# ---- Phase 3: answer generation ----
# "extractive" returns the Phase-2 bullet list verbatim (offline, no LLM);
# "gemini" synthesizes a natural-language answer over the retrieved context
# with the model below (requires GEMINI_API_KEY).
ANSWER_PROVIDER=extractive
ANSWER_MODEL=gemini-2.5-flash

# Sessionization: a silence gap of this many minutes starts a new session, and a
# continuously-active conversation is capped at this many messages per session.
SESSION_GAP_MINUTES=30
SESSION_MAX_MESSAGES=200
# Chunks are split at message boundaries to stay under this many characters.
SESSION_MAX_CHUNK_CHARS=8000

# Retrieval: how many chunks back the semantic answer cites (hybrid top-K) and the
# reciprocal-rank-fusion constant k.
RETRIEVAL_TOP_K=6
RETRIEVAL_RRF_K=60

# If set, exported messages from this sender display name are flagged as from_me
# (the bot's own messages in the group).
# EXPORT_BOT_NAME=